# ── Telegram ───────────────────────────────────────────────
BOT_TOKEN=123456:AA-replace-me
ALLOWED_USER_IDS=123456789

# ── bina.az ────────────────────────────────────────────────
# Optional: your number in any format. If set, the bot won't ask for it.
BINA_PHONE=0557778899

# ── Browser ────────────────────────────────────────────────
HEADLESS=true
OTP_TIMEOUT=300
SESSIONS_DIR=sessions

# ── Session security ───────────────────────────────────────
# Encrypts each saved session with a per-user key. Generate with:
#   python -c "from cryptography.fernet import Fernet; print(Fernet.generate_key().decode())"
# Leave empty to skip encryption (sessions are still owner-scoped on disk).
SESSION_ENCRYPTION_KEY=
